{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=license_platform;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!!",
    "Issuer": "LicensePlatform",
    "Audience": "LicensePlatformApp",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "DefaultLimit": 100,
    "ClientEndpointLimit": 30,
    "ClientEndpointWindowSeconds": 60,
    "AdminEndpointLimit": 200,
    "AdminEndpointWindowSeconds": 60
  },
  "CorsOrigins": [
    "https://localhost:3000",
    "http://localhost:3000"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ApiKey": "your-client-api-key-change-in-production",
  "SeedData": {
    "SuperAdmin": {
      "Email": "admin@licenseplatform.com",
      "Password": "Admin@123!",
      "FullName": "Super Administrator"
    }
  },
  "AllowedHosts": "*"
}
